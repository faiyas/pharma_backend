# ==============================================================================
# PHARMATRACK V2 - PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================

# 1. Django Core Settings
SECRET_KEY=your-production-django-secret-key-min-50-chars
DEBUG=False
ALLOWED_HOSTS=.onrender.com,localhost,127.0.0.1

# 2. Database (Supabase PostgreSQL / Remote Database URL)
# Example: postgresql://postgres.xxxx:yourpassword@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=postgresql://user:password@host:port/database

# 3. CORS & CSRF Trusted Origins (Frontend Hosting e.g. Vercel)
# Example: https://pharmatrack-frontend.vercel.app,http://localhost:5173
CORS_ALLOWED_ORIGINS=https://your-frontend.vercel.app,http://localhost:5173
CSRF_TRUSTED_ORIGINS=https://*.onrender.com,https://*.vercel.app,http://localhost:5173

# 4. Supabase Storage (Evidence & Photos)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_STORAGE_BUCKET=attendance-evidence
